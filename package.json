{
  "name": "spanky",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test && node scripts/check.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "format": "prettier --write src scripts tests package.json README.md",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "prettier": "3.9.10"
  }
}
